# Copier vers /etc/glpi-maj-web/config.env (chmod 600, propriétaire glpimaj).
# Aucun secret réel ne doit être commité.

APP_PORT=8001
WEB_PORT=8090

# Chemin de la base SQLite et des caches (clone winget, etc.).
DATA_DIR=/var/lib/glpi-maj-web
DATABASE_URL=sqlite:////var/lib/glpi-maj-web/glpi-maj.db

# Secret de signature des cookies de session. Généré par install.sh.
SECRET_KEY=
# 0 tant que le service est servi en HTTP. Passer à 1 derrière HTTPS.
SESSION_COOKIE_SECURE=0
SESSION_HOURS=8

# Planificateur interne. 0 dans les tests.
SCHEDULER_ENABLED=1

# GLPI. Laisser les jetons vides active le mode démo (DEMO_MODE=auto).
GLPI_URL=http://127.0.0.1/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_BASE_URL=http://195.200.200.16

# auto : démo si les jetons GLPI sont vides. on / off pour forcer.
DEMO_MODE=auto

# Clés optionnelles. Vides par défaut : les sources restent anonymes.
NVD_API_KEY=
GITHUB_TOKEN=

# Proxy sortant optionnel (httpx le lit aussi depuis l'environnement).
# HTTPS_PROXY=http://proxy.exemple:3128

# Premier administrateur (utilisé par install.sh). Laisser le mot de passe vide
# pour qu'install.sh en génère un et l'affiche une seule fois.
ADMIN_USER=admin
ADMIN_PASSWORD=
